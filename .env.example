# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Master passcode for Super Surprise Box administrative dashboard access.
# Defaults to "admin2026" if not set in server environment.
ADMIN_PIN="admin2026"

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
# Configure via the Secrets panel in AI Studio.
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side service role key with admin privileges (Project Settings -> API).
# MUST only be used server-side; NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# DATABASE_URL: Optional direct PostgreSQL pooler connection string (Project Settings -> Database).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
