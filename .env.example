# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Master passcode for Super Surprise Box administrative dashboard access.
# Defaults to "admin2026" if not set in server environment.
ADMIN_PIN="admin2026"

# DATABASE_URL: PostgreSQL pooled connection string from your Neon console.
# Get this from Neon Dashboard -> Project -> Connection Details -> Pooled connection.
# Example: postgresql://neondb_owner:password@ep-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Configure via the Secrets / Environment panel in AI Studio.
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"
